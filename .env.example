# Copy this file to .env and fill in the values. Never commit .env.

# Required: a long random string that signs login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (It may only be left empty when FLASK_DEBUG=1, and then everyone is logged out on restart.)
SECRET_KEY=

# The site's public origin, used for canonical links, sitemap.xml, robots.txt, llms.txt,
# invite links and social share previews. Set it to your custom domain, e.g.
#   SITE_URL=https://events.example.com
# Leave empty to use whatever address the browser used.
SITE_URL=

# Set to 1 only on your own computer. Never enable debug mode on a public server.
FLASK_DEBUG=0

# Largest upload request (all files sent at once) in megabytes.
MAX_UPLOAD_MB=100

# Set to 1 when the app runs behind a proxy or load balancer (Render, Railway, Nginx, ...)
# so HTTPS and visitor IP addresses are detected correctly.
TRUST_PROXY=0

# Send cookies over HTTPS only. Defaults to on when SITE_URL starts with https://
# SESSION_COOKIE_SECURE=1

# Optional storage locations (defaults: database.db and uploads/ next to app.py).
# DATABASE_PATH=/var/data/database.db
# UPLOAD_FOLDER=/var/data/uploads
